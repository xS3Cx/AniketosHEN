ONION_SHELL_SETTING_FLOAT(vsh_right_g, 0.04f)
ONION_SHELL_SETTING_FLOAT(vsh_right_r, 1.0f)
ONION_SHELL_SETTING_BOOL(vsh_show_controls, true)
ONION_SHELL_SETTING_FLOAT(vsh_text_size, 18.0f)

/* Home-screen OSD drawn by the Shell Menu. Separate from the in-game monitor
 * bar ([overlay]): this one is drawn on the home screen, that one in games. */
ONION_SHELL_SETTING_BOOL(home_osd_enabled, true)
ONION_SHELL_SETTING_BOOL(home_osd_fps, true)
ONION_SHELL_SETTING_BOOL(home_osd_cpu, true)
ONION_SHELL_SETTING_BOOL(home_osd_gpu, true)
ONION_SHELL_SETTING_BOOL(home_osd_ram, true)
ONION_SHELL_SETTING_BOOL(home_osd_ip, true)
ONION_SHELL_SETTING_BOOL(home_osd_fan, true)

/* A looping video behind the Home screen (shellui: aniketos_shell/home_video).
 * home_video_path is the chosen file; empty means the first one found. */
ONION_SHELL_SETTING_BOOL(home_video_enabled, false)
ONION_SHELL_SETTING_STRING(home_video_path, "")
ONION_SHELL_SETTING_BOOL(home_video_sound, false)
/* How loud the video is with its sound on: percent of the player's own
 * level, 0 counting as sound off. */
ONION_SHELL_SETTING_INT(home_video_volume, 100)
/* A still image in the same place, shown when no video is. */
ONION_SHELL_SETTING_BOOL(home_image_enabled, false)
ONION_SHELL_SETTING_STRING(home_image_path, "")
/* Layers over the video or picture, each 0 (none) to 100 (shellui:
 * aniketos_shell/home_video): blur, dimming, haze, vignette and shading of
 * the top and bottom. */
ONION_SHELL_SETTING_INT(home_bg_blur, 0)
ONION_SHELL_SETTING_INT(home_bg_dim, 0)
ONION_SHELL_SETTING_INT(home_bg_haze, 0)
ONION_SHELL_SETTING_INT(home_bg_vignette, 0)
ONION_SHELL_SETTING_INT(home_bg_edges, 0)
/* Drifting particles behind Home (shellui: aniketos_shell/home_particles). */
ONION_SHELL_SETTING_BOOL(home_particles_enabled, false)
ONION_SHELL_SETTING_INT(home_particles_count, 110)
/* The presence dot forced onto avatars in Home while not online: 0 as the
 * system has it, 1 online, 2 busy, 3 appearing offline (shellui: home_js). */
ONION_SHELL_SETTING_INT(home_presence_dot, 0)
/* A bookmark tab on Home after Emulators, named by the user and filled
 * from a game's Options menu (shellui: aniketos_shell/home_bookmark). */
ONION_SHELL_SETTING_BOOL(home_bookmark, true)
/* A key after Shift on the system keyboard that turns the letter keys into
 * pages of the console's glyphs (shellui: aniketos_shell/osk_glyphs). */
ONION_SHELL_SETTING_BOOL(osk_glyph_key, true)
/* The look of the system's on/off switches: 0 the system's own, 1 and up
 * the styles of shellui's aniketos_theme/toggle_styles. */
ONION_SHELL_SETTING_INT(shell_toggle_style, 0)

/* Master switch for every change to the interface's look the menu makes
 * (shellui: aniketos_theme/customization.hpp). The HEN button and the
 * Emulators tab stay either way. */
ONION_SHELL_SETTING_BOOL(shell_customization_enabled, true)

/* The shape ShellUI is laid out for: 0 is the console's 16:9, the others are
 * the ultrawide formats of aniketos_shell/screen_rotation (by index). */
ONION_SHELL_SETTING_INT(screen_format, 0)
