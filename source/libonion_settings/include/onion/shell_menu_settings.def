ONION_SHELL_SETTING_INT(shell_ui_panels_r, 255)
ONION_SHELL_SETTING_INT(shell_ui_panels_strength, 100)
ONION_SHELL_SETTING_INT(vsh_animation, 0)
ONION_SHELL_SETTING_FLOAT(vsh_background_opacity, 0.75f)
ONION_SHELL_SETTING_FLOAT(vsh_border, 4.0f)
ONION_SHELL_SETTING_BOOL(vsh_border_enabled, true)
ONION_SHELL_SETTING_INT(vsh_buzzer_volume, 0)
ONION_SHELL_SETTING_INT(vsh_color_animation, 3)
ONION_SHELL_SETTING_INT(vsh_color_animation_speed, 100)
ONION_SHELL_SETTING_BOOL(vsh_dual_color, false)
ONION_SHELL_SETTING_INT(vsh_font_weight, 1)
ONION_SHELL_SETTING_BOOL(vsh_global_theme_enabled, true)
ONION_SHELL_SETTING_INT(vsh_gradient_direction, 0)
ONION_SHELL_SETTING_FLOAT(vsh_left_b, 0.08f)
ONION_SHELL_SETTING_FLOAT(vsh_left_g, 0.04f)
ONION_SHELL_SETTING_FLOAT(vsh_left_r, 1.0f)
ONION_SHELL_SETTING_INT(vsh_menu_appearance, 0)
