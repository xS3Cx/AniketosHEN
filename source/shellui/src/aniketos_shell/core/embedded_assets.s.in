/* Everything embedded in ShellUI, so it can hand pictures to PUI from its own
   data folder instead of relying on a file in a system directory. Each file
   gets the symbols <name>_start and <name>_end. */
.intel_syntax noprefix
.section .rodata

.macro embed name, file
.p2align 4
.global \name\()_start
.type \name\()_start,@object
\name\()_start:
.incbin "\file"
.global \name\()_end
.type \name\()_end,@object
\name\()_end:
.endm

embed aniketos_icon_png, "@ANIKETOS_ICON_PNG@"
embed aniketos_icon_rgba, "@ANIKETOS_ICON_RGBA@"
embed home_menu_internet_on_png, "@HOME_MENU_ASSETS@/internet_on.png"
embed home_menu_internet_off_png, "@HOME_MENU_ASSETS@/internet_off.png"
embed color_track_png, "@HOME_MENU_ASSETS@/color_track.png"
embed color_track_gray_png, "@HOME_MENU_ASSETS@/color_track_gray.png"
embed color_track_solid_png, "@HOME_MENU_ASSETS@/color_track_solid.png"
embed color_track_fade_png, "@HOME_MENU_ASSETS@/color_track_fade.png"
embed particle_triangle_png, "@PARTICLE_ASSETS@/triangle.png"
embed particle_circle_png, "@PARTICLE_ASSETS@/circle.png"
embed particle_cross_png, "@PARTICLE_ASSETS@/cross.png"
embed particle_square_png, "@PARTICLE_ASSETS@/square.png"
embed particle_dot_png, "@PARTICLE_ASSETS@/dot.png"
embed home_background_vignette_png, "@HOME_BACKGROUND_ASSETS@/vignette.png"
embed home_background_edges_png, "@HOME_BACKGROUND_ASSETS@/edges.png"
